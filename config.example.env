GREE_API_TOKEN=replace-with-a-long-random-token
GREE_WEB_PASSWORD=replace-with-a-friendly-strong-password
GREE_SESSION_SECRET=replace-with-an-independent-random-secret
GREE_TARGET_IPS=192.168.0.124,192.168.0.131,192.168.0.134
GREE_DISCOVERY_SECONDS=5
GREE_HOST=0.0.0.0
GREE_PORT=8765
SONY_TV_IP=192.168.0.142
SONY_TV_NAME=客厅电视
SONY_TV_PSK=replace-with-the-tv-pre-shared-key
